# Copy to .env and fill in your own keys (.env is gitignored — never commit it).

# Engine mặc định của server (nút trên Header ghi đè theo từng máy).
# STT: gemini-live (mặc định, cần GEMINI_API_KEY) | whisper.  TTS: browser (mặc định) | edge.
# (FPT.AI đã bỏ: FPT_API_KEY / TTS_PRIMARY không còn được code đọc.)
STT_ENGINE=gemini-live
TTS_ENGINE=browser

# LLM cho agent hội thoại + geocode fallback (DeepSeek mặc định, OpenAI-compatible)
DEEPSEEK_API_KEY=your_deepseek_key_here
# Tuỳ chọn ghi đè (mặc định đã trỏ DeepSeek):
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat
# LLM_GEOCODE_MODEL=deepseek-chat
# Muốn quay lại Groq: LLM_API_KEY=<groq key>, LLM_BASE_URL=https://api.groq.com/openai/v1, LLM_MODEL=openai/gpt-oss-120b

# Groq — Whisper Speech-to-Text (GIỮ trên Groq; DeepSeek không nhận dạng giọng nói)
GROQ_WHISPER_KEY=your_groq_whisper_key_here
GROQ_WHISPER_MODEL=whisper-large-v3

# Gemini: ephemeral token cho Gemini Live STT (mặc định) + grounding cho geocode.
# Thiếu key -> /api/health báo gemini_live:false, STT lùi về Whisper.
# Thêm key: GEMINI_API_KEYS=k2,k3 (cộng dồn quota); GEMINI_MODELS = model theo từng key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# GEMINI_LIVE_MODEL=gemini-3.5-transcribe-live

# Tuỳ chọn: Mapbox cho geocode/directions; trống -> OSM/OSRM
# MAPBOX_TOKEN=

# MongoDB — local default works with: mongod --dbpath ./mongo-data
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=voicego
DEMO_PASSENGER_ID=demo-passenger-visual
